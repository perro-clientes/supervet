# Sanity project (público, embebido en el client del browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Fecha fija de la API de Sanity (no cambiar una vez en uso)
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# Token de lectura (server-side, role Viewer). Sanity Manage → API → Tokens
SANITY_API_READ_TOKEN=

# Token de escritura (solo para scripts/seed, role Editor). No exponer en el browser
SANITY_API_WRITE_TOKEN=

# Secreto para activar Draft Mode / Visual Editing
SANITY_PREVIEW_SECRET=

# Resend (formulario de contacto)
RESEND_API_KEY=
RESEND_TO_EMAIL=supervetclinicadeanimales@gmail.com
